{
  "name": "code-review-system",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Process-embedded multi-source code review middleware for DSH",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "crs": "./dist/cli.js"
  },
  "main": "./dist/plugin.js",
  "types": "./dist/plugin.d.ts",
  "exports": {
    ".": {
      "types": "./dist/plugin.d.ts",
      "default": "./dist/plugin.js"
    },
    "./core": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "schemas",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "gen:schema": "tsx scripts/gen-schemas.ts",
    "check:schema": "npm run gen:schema && git diff --exit-code -- schemas",
    "dataset:build": "tsx scripts/build-ds2.ts --emit",
    "dataset:verify": "tsx scripts/verify-dataset.ts",
    "calibrate": "tsx scripts/calibrate.ts",
    "report": "tsx scripts/report.ts",
    "drill": "tsx scripts/live-drill.ts",
    "drill:context": "tsx scripts/upstream-context.ts --dataset datasets/self-built --config configs/b4.json --out artifacts/staged-context.json",
    "wiring:check": "node scripts/run.mjs wiring-check",
    "gate:machine": "node scripts/run.mjs instrument-gate",
    "gate:residue": "node scripts/run.mjs residue-check",
    "gate:degeneration": "node scripts/run.mjs silent-degeneration",
    "gate:replay": "node scripts/run.mjs gate-replay",
    "gate:hashes": "node scripts/run.mjs hash-agreement",
    "gate:all": "node scripts/run.mjs gate-replay && node scripts/run.mjs hash-agreement && node scripts/run.mjs silent-degeneration",
    "env:probe": "node scripts/run.mjs env-probe",
    "check:secrets": "tsx scripts/secret-gate.ts",
    "dataset:check": "tsx scripts/build-ds2.ts --check",
    "record:fit": "tsx scripts/record-dataset.ts --split fit --matrix"
  },
  "dependencies": {
    "execa": "^9.5.2",
    "p-limit": "^6.2.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8",
    "zod-to-json-schema": "^3.24.1"
  }
}
