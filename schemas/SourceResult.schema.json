{
  "$ref": "#/definitions/SourceResult",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "SourceResult": {
      "additionalProperties": false,
      "properties": {
        "coverage": {
          "additionalProperties": false,
          "properties": {
            "filesCovered": {
              "minimum": 0,
              "type": "integer"
            },
            "filesUnknown": {
              "minimum": 0,
              "type": "integer"
            }
          },
          "required": [
            "filesCovered",
            "filesUnknown"
          ],
          "type": "object"
        },
        "errorKind": {
          "type": [
            "string",
            "null"
          ]
        },
        "findings": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "certified": {
                "type": "boolean"
              },
              "confidence": {
                "maximum": 1,
                "minimum": 0,
                "type": "number"
              },
              "cwe": {
                "anyOf": [
                  {
                    "pattern": "^CWE-\\d+$",
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "endLine": {
                "minimum": 0,
                "type": "integer"
              },
              "evidence": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "file": {
                "minLength": 1,
                "type": "string"
              },
              "rawId": {
                "minLength": 1,
                "type": "string"
              },
              "severity": {
                "type": "number"
              },
              "source": {
                "enum": [
                  "semgrep",
                  "aor",
                  "crg",
                  "registry"
                ],
                "type": "string"
              },
              "startLine": {
                "minimum": 0,
                "type": "integer"
              },
              "symbol": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "file",
              "startLine",
              "endLine",
              "severity",
              "confidence",
              "source",
              "rawId"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "latencyMs": {
          "minimum": 0,
          "type": "number"
        },
        "source": {
          "enum": [
            "semgrep",
            "aor",
            "crg",
            "registry"
          ],
          "type": "string"
        },
        "status": {
          "enum": [
            "ok",
            "timeout",
            "error",
            "degraded"
          ],
          "type": "string"
        },
        "synthetic": {
          "type": "boolean"
        },
        "tokenDetail": {
          "anyOf": [
            {
              "additionalProperties": false,
              "properties": {
                "cacheRead": {
                  "anyOf": [
                    {
                      "minimum": 0,
                      "type": "integer"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "cacheWrite": {
                  "anyOf": [
                    {
                      "minimum": 0,
                      "type": "integer"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "input": {
                  "anyOf": [
                    {
                      "minimum": 0,
                      "type": "integer"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "output": {
                  "anyOf": [
                    {
                      "minimum": 0,
                      "type": "integer"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "total": {
                  "anyOf": [
                    {
                      "minimum": 0,
                      "type": "integer"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "total",
                "input",
                "output",
                "cacheRead",
                "cacheWrite"
              ],
              "type": "object"
            },
            {
              "type": "null"
            }
          ]
        },
        "tokens": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "source",
        "status",
        "findings",
        "coverage",
        "tokens",
        "latencyMs"
      ],
      "type": "object"
    }
  }
}
