{
  "$ref": "#/definitions/CalibrationArtifact",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "CalibrationArtifact": {
      "additionalProperties": false,
      "properties": {
        "categories": {
          "items": {
            "minLength": 1,
            "type": "string"
          },
          "type": "array"
        },
        "dataset_version": {
          "minLength": 1,
          "type": "string"
        },
        "fitRoot": {
          "minLength": 1,
          "type": "string"
        },
        "grids": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "category": {
                "type": "string"
              },
              "n": {
                "minimum": 0,
                "type": "integer"
              },
              "points": {
                "items": {
                  "additionalProperties": false,
                  "properties": {
                    "p": {
                      "maximum": 1,
                      "minimum": 0,
                      "type": "number"
                    },
                    "rawHigh": {
                      "type": "number"
                    },
                    "rawLow": {
                      "type": "number"
                    }
                  },
                  "required": [
                    "rawLow",
                    "rawHigh",
                    "p"
                  ],
                  "type": "object"
                },
                "type": "array"
              },
              "source": {
                "enum": [
                  "semgrep",
                  "aor",
                  "crg",
                  "registry"
                ],
                "type": "string"
              }
            },
            "required": [
              "source",
              "category",
              "n",
              "points"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "pMax": {
          "exclusiveMinimum": 0,
          "maximum": 1,
          "type": "number"
        },
        "pPrior": {
          "exclusiveMaximum": 1,
          "exclusiveMinimum": 0,
          "type": "number"
        },
        "ruleset_fingerprint": {
          "minLength": 1,
          "type": "string"
        },
        "shrinkageN0": {
          "exclusiveMinimum": 0,
          "type": "number"
        },
        "synthetic": {
          "type": "boolean"
        },
        "thresholds": {
          "additionalProperties": false,
          "properties": {
            "causes": {
              "additionalProperties": false,
              "properties": {
                "class_declarations": {
                  "minimum": 0,
                  "type": "integer"
                },
                "class_rules": {
                  "minimum": 0,
                  "type": "integer"
                },
                "fit_negatives": {
                  "minimum": 0,
                  "type": "integer"
                },
                "n_fit": {
                  "minimum": 0,
                  "type": "integer"
                }
              },
              "required": [
                "fit_negatives",
                "class_declarations",
                "class_rules",
                "n_fit"
              ],
              "type": "object"
            },
            "global": {
              "additionalProperties": false,
              "properties": {
                "block": {
                  "anyOf": [
                    {
                      "maximum": 1,
                      "minimum": 0,
                      "type": "number"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "warn": {
                  "anyOf": [
                    {
                      "maximum": 1,
                      "minimum": 0,
                      "type": "number"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "block",
                "warn"
              ],
              "type": "object"
            },
            "perCategory": {
              "additionalProperties": {
                "additionalProperties": false,
                "properties": {
                  "block": {
                    "anyOf": [
                      {
                        "maximum": 1,
                        "minimum": 0,
                        "type": "number"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "warn": {
                    "anyOf": [
                      {
                        "maximum": 1,
                        "minimum": 0,
                        "type": "number"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  }
                },
                "required": [
                  "block",
                  "warn"
                ],
                "type": "object"
              },
              "type": "object"
            },
            "skipped": {
              "items": {
                "additionalProperties": false,
                "properties": {
                  "reason": {
                    "type": "string"
                  },
                  "scope": {
                    "type": "string"
                  }
                },
                "required": [
                  "scope",
                  "reason"
                ],
                "type": "object"
              },
              "type": "array"
            },
            "status": {
              "enum": [
                "fitted",
                "unfittable"
              ],
              "type": "string"
            }
          },
          "required": [
            "global",
            "perCategory",
            "skipped"
          ],
          "type": "object"
        },
        "version": {
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "version",
        "dataset_version",
        "ruleset_fingerprint",
        "categories",
        "pPrior",
        "shrinkageN0",
        "pMax",
        "fitRoot",
        "grids",
        "thresholds"
      ],
      "type": "object"
    }
  }
}
