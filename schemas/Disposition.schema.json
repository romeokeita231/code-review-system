{
  "$ref": "#/definitions/Disposition",
  "$schema": "http://json-schema.org/draft-07/schema#",
  "definitions": {
    "Disposition": {
      "additionalProperties": false,
      "properties": {
        "blockLoop": {
          "type": "boolean"
        },
        "finalDisposition": {
          "enum": [
            "mechanical_block",
            "instruction_correction",
            "record"
          ],
          "type": "string"
        },
        "findings": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "blockable": {
                "type": "boolean"
              },
              "certified": {
                "type": "boolean"
              },
              "confidence": {
                "maximum": 1,
                "minimum": 0,
                "type": "number"
              },
              "conflictResolution": {
                "enum": [
                  "none",
                  "evidence_preferred",
                  "vote",
                  "downgraded"
                ],
                "type": "string"
              },
              "cwe": {
                "anyOf": [
                  {
                    "pattern": "^CWE-\\d+$",
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "cweComparable": {
                "type": "boolean"
              },
              "endLine": {
                "minimum": 0,
                "type": "integer"
              },
              "evidence": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "evidenceSources": {
                "items": {
                  "enum": [
                    "semgrep",
                    "aor",
                    "crg",
                    "registry"
                  ],
                  "type": "string"
                },
                "type": "array"
              },
              "file": {
                "minLength": 1,
                "type": "string"
              },
              "rawId": {
                "minLength": 1,
                "type": "string"
              },
              "rawIds": {
                "items": {
                  "minLength": 1,
                  "type": "string"
                },
                "minItems": 1,
                "type": "array"
              },
              "severity": {
                "type": "number"
              },
              "severitySource": {
                "anyOf": [
                  {
                    "enum": [
                      "semgrep",
                      "aor",
                      "crg",
                      "registry"
                    ],
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "source": {
                "enum": [
                  "semgrep",
                  "aor",
                  "crg",
                  "registry"
                ],
                "type": "string"
              },
              "sources": {
                "items": {
                  "enum": [
                    "semgrep",
                    "aor",
                    "crg",
                    "registry"
                  ],
                  "type": "string"
                },
                "minItems": 1,
                "type": "array"
              },
              "startLine": {
                "minimum": 0,
                "type": "integer"
              },
              "symbol": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "file",
              "startLine",
              "endLine",
              "severity",
              "confidence",
              "source",
              "rawId",
              "sources",
              "rawIds",
              "evidenceSources",
              "cweComparable",
              "conflictResolution",
              "blockable"
            ],
            "type": "object"
          },
          "type": "array"
        },
        "gate": {
          "additionalProperties": false,
          "properties": {
            "perFileTier": {
              "additionalProperties": {
                "enum": [
                  0,
                  1,
                  2
                ],
                "type": "number"
              },
              "type": "object"
            }
          },
          "required": [
            "perFileTier"
          ],
          "type": "object"
        },
        "mechanism": {
          "enum": [
            "mechanical_block",
            "instruction_correction",
            "record"
          ],
          "type": "string"
        },
        "pFused": {
          "type": [
            "number",
            "null"
          ]
        },
        "pSemgrep": {
          "type": [
            "number",
            "null"
          ]
        },
        "postDecision": {
          "enum": [
            "inject_warn",
            "none",
            "not_run"
          ],
          "type": "string"
        },
        "preDecision": {
          "enum": [
            "deny",
            "allow",
            "not_run"
          ],
          "type": "string"
        },
        "reviewStatus": {
          "enum": [
            "ok",
            "degraded",
            "skipped"
          ],
          "type": "string"
        },
        "skipReason": {
          "anyOf": [
            {
              "enum": [
                "no_supported_files",
                "language_unsupported",
                "resource_limit",
                "turn_budget_exhausted",
                "budget_exhausted",
                "index_not_ready",
                "index_stale",
                "aor_timeout",
                "aor_partial",
                "no_evidence",
                "tier0_no_semantic",
                "duplicate_reuse",
                "no_change",
                "command_event",
                "disposition_missing"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "text": {
          "type": [
            "string",
            "null"
          ]
        },
        "thresholdSource": {
          "anyOf": [
            {
              "enum": [
                "artifact",
                "config",
                "severity_policy"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "tier": {
          "enum": [
            0,
            1,
            2
          ],
          "type": "number"
        },
        "tierSource": {
          "enum": [
            "triage",
            "static",
            "none"
          ],
          "type": "string"
        }
      },
      "required": [
        "mechanism",
        "findings",
        "text",
        "pSemgrep",
        "pFused",
        "preDecision",
        "postDecision",
        "finalDisposition",
        "reviewStatus",
        "skipReason",
        "blockLoop",
        "tier",
        "tierSource",
        "thresholdSource"
      ],
      "type": "object"
    }
  }
}
