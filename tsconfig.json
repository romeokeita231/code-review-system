{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": false,
    "declaration": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@contracts": ["src/contracts/index.ts"],
      "@config": ["src/config/index.ts"],
      "@l1": ["src/l1/index.ts"],
      "@l2": ["src/l2/index.ts"],
      "@l3": ["src/l3/index.ts"],
      "@l4": ["src/l4/index.ts"],
      "@l5": ["src/l5/index.ts"]
    }
  },
  "include": ["src", "scripts", "tests", "tsup.config.ts", "vitest.config.ts"]
}
